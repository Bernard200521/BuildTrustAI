# ==============================================================================
# BuildTrust AI - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Security & Authentication
# Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change-this-in-production-buildtrust-secret-key-32chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial Admin Bootstrap (Used by bootstrap script / local dev)
INITIAL_ADMIN_EMAIL=admin@buildtrust.ai
INITIAL_ADMIN_PASSWORD=BuildTrustAdmin2026!
INITIAL_ADMIN_ROLE=ADMIN

# Storage Backend: 'local' (JSON/SQLite local store) or 'aws' (DynamoDB + S3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=backend/data

# AWS Cloud Configuration (Required only when STORAGE_BACKEND=aws)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET_NAME=buildtrust-ai-evidence-vault-demo
DYNAMODB_TABLE_NAME=BuildTrustRecords
CLOUDWATCH_LOG_GROUP=/aws/apprunner/buildtrust-ai-backend

# Vulnerability Scanning (OSV.dev integration)
OSV_API_ENABLED=true
OSV_API_TIMEOUT_SECONDS=10
OSV_BATCH_SIZE=20

# Machine Learning & Anomaly Detection
ML_ENABLED=true
ML_MODEL_PATH=backend/app/ml/models/isolation_forest.joblib
ML_CONTAMINATION_RATE=0.08

# Evidence & Ingestion Limits
MAX_EVIDENCE_PAYLOAD_BYTES=10485760 # 10MB
MAX_ARTIFACT_UPLOAD_BYTES=104857600 # 100MB

# Trust Engine Baseline Thresholds
POLICY_APPROVAL_THRESHOLD=85.0
POLICY_REVIEW_THRESHOLD=60.0
